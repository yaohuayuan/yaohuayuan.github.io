---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingTools from '../components/ReadingTools.astro';
import { getCategoryLabel, getTagLabel } from '../data/taxonomy';
import { getSeriesLabel, type SeriesId } from '../data/series';
import '../styles/article.css';

interface Props {
	title: string;
	description: string;
	date: Date;
	categories: string[];
	tags: string[];
	series?: SeriesId;
	seriesArticles?: CollectionEntry<'articles'>[];
	articleId?: string;
	previous?: CollectionEntry<'articles'>;
	next?: CollectionEntry<'articles'>;
	updated?: Date;
	headings: MarkdownHeading[];
}

const { title, description, date, categories, tags, series, seriesArticles = [], articleId, previous, next, updated, headings } = Astro.props;
const formattedDate = date.toISOString().slice(0, 10);
const formatDate = (entryDate: Date) => entryDate.toISOString().slice(0, 10);
---

<BaseLayout
	title={title}
	description={description}
	type="article"
	publishedTime={date}
	modifiedTime={updated}
>
	<ReadingTools />
	<div class="article-page">
		<article class="article" data-pagefind-body>
			<header class="article-header">
				<h1>{title}</h1>
				<p class="article-description">{description}</p>
				<time class="article-date" datetime={formattedDate}>{formattedDate}</time>
				{(categories.length > 0 || tags.length > 0 || series) && (
					<div class="article-taxonomy" aria-label="文章分类信息">
						{categories.length > 0 && (
							<div class="taxonomy-row">
								<span>分类</span>
								{categories.map((category) => (
									<a href={`/categories/${category}/`}>{getCategoryLabel(category)}</a>
								))}
							</div>
						)}
						{tags.length > 0 && (
							<div class="taxonomy-row">
								<span>标签</span>
								{tags.map((tag) => (
									<a href={`/tags/${tag}/`}>{getTagLabel(tag)}</a>
								))}
							</div>
						)}
						{series && (
							<div class="taxonomy-row">
								<span>系列</span>
								<a href={`/series/${series}/`}>{getSeriesLabel(series)}</a>
							</div>
						)}
					</div>
				)}
			</header>

			<div class="article-body-layout">
				<TableOfContents headings={headings} />

				<div class="article-content">
					<slot />
				</div>
			</div>

			{series && (
				<aside class="series-directory" data-pagefind-ignore>
					<a class="text-link" href={`/series/${series}/`}>← {getSeriesLabel(series)} · 查看完整专题</a>
					{seriesArticles.length > 0 && <details>
						<summary>系列内文章目录 · {seriesArticles.length} 篇</summary>
						<ol>{seriesArticles.map((item) => <li><a href={`/articles/${item.id}/`} aria-current={item.id === articleId ? 'page' : undefined}>{item.data.title}</a></li>)}</ol>
					</details>}
				</aside>
			)}
			{(previous || next) && (
				<nav class="series-nav" aria-label={`${series ? getSeriesLabel(series) : ''}系列导航`}>
					{previous ? (
						<a class="series-nav__link series-nav__link--previous" href={`/articles/${previous.id}/`} rel="prev">
							<span class="series-nav__label">← 上一篇</span>
							<span class="series-nav__title">{previous.data.title}</span>
							<time datetime={formatDate(previous.data.date)}>{formatDate(previous.data.date)}</time>
						</a>
					) : <span class="series-nav__spacer" aria-hidden="true"></span>}
					{next ? (
						<a class="series-nav__link series-nav__link--next" href={`/articles/${next.id}/`} rel="next">
							<span class="series-nav__label">下一篇 →</span>
							<span class="series-nav__title">{next.data.title}</span>
							<time datetime={formatDate(next.data.date)}>{formatDate(next.data.date)}</time>
						</a>
					) : <span class="series-nav__spacer" aria-hidden="true"></span>}
				</nav>
			)}
		</article>
	</div>
</BaseLayout>

<style>
	.series-directory { margin-top:3rem; padding:1.2rem; border:1px solid var(--color-border); border-radius:var(--radius-md); background:var(--color-surface-soft); }
	.series-directory details { margin-top:.8rem; font-size:.85rem; }
	.series-directory summary { cursor:pointer; color:var(--color-text-secondary); }
	.series-directory li { padding-block:.3rem; overflow-wrap:anywhere; }
	.series-directory a[aria-current="page"] { font-weight:650; color:var(--color-text); }
	.article-taxonomy {
		display: grid;
		margin-top: 1rem;
		gap: 0.35rem;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.02em;
	}

	.taxonomy-row {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
	}

	.taxonomy-row > span {
		min-width: 3rem;
		color: var(--color-text-secondary);
		font-weight: 650;
	}

	.taxonomy-row a {
		text-decoration-color: transparent;
	}

	.taxonomy-row a:hover {
		text-decoration-color: currentColor;
	}

	.series-nav {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 3.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
	}

	.series-nav__link {
		display: grid;
		gap: 0.3rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		text-decoration: none;
	}

	.series-nav__link:hover {
		border-color: var(--color-accent);
	}

	.series-nav__link--next {
		text-align: right;
	}

	.series-nav__label {
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.63rem;
		letter-spacing: 0.04em;
	}

	.series-nav__title {
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.series-nav time {
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.63rem;
	}

	@media (max-width: 620px) {
		.series-nav {
			grid-template-columns: 1fr;
		}

		.series-nav__link--next {
			text-align: left;
		}

		.series-nav__spacer {
			display: none;
		}
	}
</style>
