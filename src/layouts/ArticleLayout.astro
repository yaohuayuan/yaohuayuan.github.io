---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingTools from '../components/ReadingTools.astro';
import { getCategoryLabel, getSeriesLabel, getTagLabel } from '../data/taxonomy';
import '../styles/article.css';

interface Props {
	title: string;
	description: string;
	date: Date;
	categories: string[];
	tags: string[];
	series?: string;
	updated?: Date;
	headings: MarkdownHeading[];
}

const { title, description, date, categories, tags, series, updated, headings } = Astro.props;
const formattedDate = date.toISOString().slice(0, 10);
---

<BaseLayout
	title={title}
	description={description}
	type="article"
	publishedTime={date}
	modifiedTime={updated}
>
	<ReadingTools />
	<div class="article-page">
		<article class="article" data-pagefind-body>
			<header class="article-header">
				<h1>{title}</h1>
				<p class="article-description">{description}</p>
				<time class="article-date" datetime={formattedDate}>{formattedDate}</time>
				{(categories.length > 0 || tags.length > 0 || series) && (
					<div class="article-taxonomy" aria-label="文章分类信息">
						{categories.length > 0 && (
							<div class="taxonomy-row">
								<span>分类</span>
								{categories.map((category) => (
									<a href={`/categories/${category}/`}>{getCategoryLabel(category)}</a>
								))}
							</div>
						)}
						{tags.length > 0 && (
							<div class="taxonomy-row">
								<span>标签</span>
								{tags.map((tag) => (
									<a href={`/tags/${tag}/`}>{getTagLabel(tag)}</a>
								))}
							</div>
						)}
						{series && (
							<div class="taxonomy-row">
								<span>系列</span>
								<a href={`/series/${series}/`}>{getSeriesLabel(series)}</a>
							</div>
						)}
					</div>
				)}
			</header>

			<div class="article-body-layout">
				<TableOfContents headings={headings} />

				<div class="article-content">
					<slot />
				</div>
			</div>
		</article>
	</div>
</BaseLayout>

<style>
	.article-taxonomy {
		display: grid;
		margin-top: 1rem;
		gap: 0.35rem;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.02em;
	}

	.taxonomy-row {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
	}

	.taxonomy-row > span {
		min-width: 3rem;
		color: var(--color-text-secondary);
		font-weight: 650;
	}

	.taxonomy-row a {
		text-decoration-color: transparent;
	}

	.taxonomy-row a:hover {
		text-decoration-color: currentColor;
	}
</style>
