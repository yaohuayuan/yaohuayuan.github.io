---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
import '../../styles/page.css';
---
<BaseLayout title="项目档案" description="曜花缘的开源项目档案：DBMS_C、AI-NATIVE-DBMS-C，以及正在酝酿中的 Aster。">
<div class="content-page"><header class="page-header"><p class="section-label">PROJECTS / BUILD TO UNDERSTAND</p><h1>在构建中理解系统。</h1><p class="page-intro">从一个可运行的原型开始，记录架构、取舍，以及每一次向前的迭代。</p></header>
<div class="projects-grid">{projects.map((project,index) => <ProjectCard project={project} index={index}/>)}</div>
<p class="project-footnote">项目详情区分已记录的实现与研究规划。每一个阶段，都值得被保存。</p></div>
</BaseLayout>
<style>.projects-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.3rem;}.project-footnote{margin-top:2rem;color:var(--color-muted);font-size:.85rem;}@media(max-width:800px){.projects-grid{grid-template-columns:1fr;}}</style>