---
import { getCollection } from 'astro:content';
import ArticleList from '../../components/ArticleList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import { getSeriesLabel } from '../../data/taxonomy';
import '../../styles/page.css';

export async function getStaticPaths() {
	const publishedArticles = (await getCollection('articles'))
		.filter((entry) => !entry.data.draft && entry.data.series);
	const seriesSlugs = new Set(
		publishedArticles.flatMap((entry) => entry.data.series ? [entry.data.series] : []),
	);

	return Array.from(seriesSlugs, (series) => ({
		params: { series },
		props: {
			series,
			articles: publishedArticles
				.filter((entry) => entry.data.series === series)
				.sort((a, b) =>
					a.data.date.valueOf() - b.data.date.valueOf() ||
					a.data.title.localeCompare(b.data.title, 'zh-CN')
				),
		},
	}));
}

const { series, articles } = Astro.props;
const seriesLabel = getSeriesLabel(series);
// 项目关联：由 projects.ts 的 series 字段反查，未关联项目时保持原有简洁页面。
const project = projects.find((item) => item.series === series);
const seriesLead = articles[0];
---

<BaseLayout title={seriesLabel} description={`${seriesLabel}系列文章。`}>
	<div class="content-page">
		<header class="page-header">
			<p class="section-label">SERIES / READ IN ORDER</p>
			<h1>{seriesLabel}</h1>
			{seriesLead ? <p class="page-intro">{seriesLead.data.description}</p> : <p class="page-intro">系列：{series}</p>}
			<p class="series-count">{articles.length} 篇 · 按发布日期连续阅读</p>
		</header>

		{project && (
			<aside class="series-project">
				<span aria-hidden="true">↳</span>
				<div>
					<p class="series-project__label">所属项目</p>
					<h2>{project.name}</h2>
					<p>{project.description}</p>
					<div class="series-project__links">
						<a class="button" href={`/projects/${project.slug}/`}>项目主页 <span aria-hidden="true">↗</span></a>
						{project.github && <a class="text-link" href={project.github}>GitHub Repository <span aria-hidden="true">↗</span></a>}
					</div>
				</div>
			</aside>
		)}

		<ArticleList articles={articles} ariaLabel={`${seriesLabel}系列文章列表`} />
	</div>
</BaseLayout>

<style>
	.series-count {
		margin-top: 1rem;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
	}

	.series-project {
		display: flex;
		gap: 1.2rem;
		margin: 2.5rem 0;
		padding: 1.4rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface-soft);
	}

	.series-project > span {
		color: var(--color-accent);
		font-size: 1.2rem;
		line-height: 1.4;
	}

	.series-project__label {
		margin: 0 0 0.3rem;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.06em;
	}

	.series-project h2 {
		margin: 0 0 0.5rem;
		font-size: 1.15rem;
		overflow-wrap: anywhere;
	}

	.series-project p {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: 0.85rem;
		line-height: 1.85;
	}

	.series-project__links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.2rem;
		margin-top: 1.1rem;
	}
</style>
