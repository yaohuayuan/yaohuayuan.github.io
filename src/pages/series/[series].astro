---
import { getCollection } from 'astro:content';
import ArticleList from '../../components/ArticleList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import { seriesIds } from '../../data/series';
import { getSeriesSummary } from '../../lib/series';
import '../../styles/page.css';

export async function getStaticPaths() {
	const entries = await getCollection('articles');
	return seriesIds.map((series) => ({
		params: { series },
		props: { summary: getSeriesSummary(entries, series) },
	}));
}

const { summary } = Astro.props;
const { id, title, description, articles, count, updated, sort } = summary;
const project = projects.find((item) => item.series === id);
const updatedDate = updated?.toISOString().slice(0, 10);
---

<BaseLayout title={title} description={description}>
	<div class="content-page">
		<a class="text-link" href="/series/">← 所有系列</a>
		<header class="page-header">
			<p class="section-label">SERIES / {sort === 'ordered' ? 'READ IN ORDER' : 'LATEST NOTES'}</p>
			<h1>{title}</h1>
			<p class="page-intro">{description}</p>
			<p class="series-count">{count} 篇文章 · {sort === 'ordered' ? '按章节顺序阅读' : '按发布时间倒序'}{updatedDate && <> · 更新于 <time datetime={updatedDate}>{updatedDate}</time></>}</p>
		</header>

		{project && (
			<aside class="series-project">
				<span aria-hidden="true">↳</span>
				<div>
					<p class="series-project__label">关联项目</p>
					<h2>{project.name}</h2>
					<p>{project.description}</p>
					<div class="series-project__links">
						<a class="button" href={`/projects/${project.slug}/`}>项目主页 <span aria-hidden="true">↗</span></a>
						{project.github && <a class="text-link" href={project.github}>GitHub Repository <span aria-hidden="true">↗</span></a>}
					</div>
				</div>
			</aside>
		)}

		<section aria-labelledby="series-contents">
			<h2 id="series-contents">文章目录</h2>
			{count > 0 ? <ArticleList articles={articles} ariaLabel={`${title}系列文章列表`} showSeriesOrder={sort === 'ordered'} /> : <p class="series-empty">这个专题还在积累中，文章发布后会出现在这里。</p>}
		</section>
	</div>
</BaseLayout>

<style>
	.page-header { margin-top: 2rem; }
	#series-contents { font-size: 1.2rem; margin-bottom: 1.2rem; }
	.series-empty { padding: 1.5rem; border: 1px dashed var(--color-border-strong); border-radius: var(--radius-md); color: var(--color-muted); }
	.series-count time { font-size: inherit; }
	.series-count {
		margin-top: 1rem;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
	}

	.series-project {
		display: flex;
		gap: 1.2rem;
		margin: 2.5rem 0;
		padding: 1.4rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface-soft);
	}

	.series-project > span {
		color: var(--color-accent);
		font-size: 1.2rem;
		line-height: 1.4;
	}

	.series-project__label {
		margin: 0 0 0.3rem;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.06em;
	}

	.series-project h2 {
		margin: 0 0 0.5rem;
		font-size: 1.15rem;
		overflow-wrap: anywhere;
	}

	.series-project p {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: 0.85rem;
		line-height: 1.85;
	}

	.series-project__links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.2rem;
		margin-top: 1.1rem;
	}
</style>
