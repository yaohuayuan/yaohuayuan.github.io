---
import { getCollection } from 'astro:content';
import ArticleList from '../../components/ArticleList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeriesLabel } from '../../data/taxonomy';
import '../../styles/page.css';

export async function getStaticPaths() {
	const publishedArticles = (await getCollection('articles'))
		.filter((entry) => !entry.data.draft && entry.data.series);
	const seriesSlugs = new Set(
		publishedArticles.flatMap((entry) => entry.data.series ? [entry.data.series] : []),
	);

	return Array.from(seriesSlugs, (series) => ({
		params: { series },
		props: {
			series,
			articles: publishedArticles
				.filter((entry) => entry.data.series === series)
				.sort((a, b) =>
					a.data.date.valueOf() - b.data.date.valueOf() ||
					a.data.title.localeCompare(b.data.title, 'zh-CN')
				),
		},
	}));
}

const { series, articles } = Astro.props;
const seriesLabel = getSeriesLabel(series);
---

<BaseLayout title={seriesLabel} description={`${seriesLabel}系列文章。`}>
	<div class="content-page">
		<header class="page-header">
			<h1>{seriesLabel}</h1>
			<p class="page-intro">系列：{series}</p>
		</header>

		<ArticleList articles={articles} ariaLabel={`${seriesLabel}系列文章列表`} />
	</div>
</BaseLayout>
