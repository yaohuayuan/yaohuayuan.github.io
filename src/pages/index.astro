---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import OrbitMap from '../components/OrbitMap.astro';
import ProjectCard from '../components/ProjectCard.astro';
import KnowledgeMap from '../components/KnowledgeMap.astro';
import { projects } from '../data/projects';
import { getCategoryLabel } from '../data/taxonomy';
import '../styles/home.css';
const articles = (await getCollection('articles')).filter(e => !e.data.draft).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const recent = articles.slice(0,3);
---
<BaseLayout title="曜花缘" description="曜花缘 / YaoHuaYuan 的个人技术档案馆。探索计算机系统、数据库与人工智能的边界，记录算法、数学建模与软件工程实践。">
<div class="home-page">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="section-label"><span class="tiny-star">✦</span> A PERSONAL TECHNICAL ARCHIVE</p>
      <h1 id="hero-title">曜花缘<span>YaoHuaYuan<span class="name-period">.</span></span></h1>
      <p class="hero-intro">探索计算机系统、数据库<br class="desktop-break"/>与人工智能的边界。</p>
      <p class="hero-description">计算机科学与技术方向的学习者与构建者。<br/>在这里，记录从理解一个原理，到构建一个系统的过程。</p>
      <div class="hero-actions"><a class="button button--primary" href="/projects/">探索我的项目 <span aria-hidden="true">↗</span></a><a class="hero-secondary" href="/about/">关于我 <span aria-hidden="true">→</span></a></div>
    </div>
    <OrbitMap/>
  </section>
  <section class="current-focus" aria-label="当前研究方向"><div><span class="focus-dot"></span><span>当前专注</span><small>CURRENT FOCUS</small></div><a href="/projects/dbms-c/">Database Kernel <span>↗</span></a><a href="/projects/ai-native-dbms/">AI Native Database <span>↗</span></a><a href="/knowledge/#cs">Computer Systems <span>↗</span></a></section>
  <section class="home-section" aria-labelledby="projects-title">
    <SectionHeading id="projects-title" index="01" label="SELECTED PROJECTS" title="在构建中理解系统" href="/projects/" link="项目档案"/>
    <div class="project-grid">{projects.map((project,index) => <ProjectCard project={project} index={index}/>)}</div>
  </section>
  <section class="home-section writing-section" aria-labelledby="writing-title">
    <SectionHeading id="writing-title" index="02" label="RECENT WRITING" title="沿途的思考与记录" href="/articles/" link="全部文章"/>
    <div class="writing-layout"><p class="writing-aside">把问题拆开，<br/>把思考留下。<span>算法 · 建模 · 开发日志</span><a href="/rss.xml">订阅 RSS ↗</a></p><ul class="writing-index">{recent.map((entry,index) => <li><a href={`/articles/${entry.id}/`}><div class="writing-meta"><time datetime={entry.data.date.toISOString()}>{entry.data.date.toISOString().slice(0,10)}</time><span>{entry.data.categories[0] ? getCategoryLabel(entry.data.categories[0]) : '技术文章'}</span></div><h3>{entry.data.title}<span aria-hidden="true">↗</span></h3><p>{entry.data.description}</p></a></li>)}</ul></div>
  </section>
  <section class="home-section" aria-labelledby="knowledge-title"><SectionHeading id="knowledge-title" index="03" label="KNOWLEDGE CONSTELLATION" title="让知识，逐渐连成星图" href="/knowledge/" link="进入知识库"/><KnowledgeMap/></section>
  <section class="labs-entry" aria-labelledby="labs-title"><div class="labs-illustration" aria-hidden="true"><span>[</span><i style="--bar:30%"></i><i style="--bar:50%"></i><i style="--bar:38%"></i><i style="--bar:78%"></i><i style="--bar:62%"></i><i style="--bar:94%"></i><span>]</span></div><div><p class="section-label">04 / THE LABORATORY</p><h2 id="labs-title">让抽象的原理，变得触手可及。</h2><p>从一次二分查找到一个缓冲池，在交互中观察系统如何工作。</p><a class="text-link" href="/labs/">进入实验室 <span aria-hidden="true">→</span></a></div><span class="lab-note">OBSERVE.<br/>QUESTION.<br/>BUILD.</span></section>
  <div class="home-colophon"><span>✦ 从好奇出发，以工程作答。</span><span>THIS ARCHIVE IS ALWAYS A WORK IN PROGRESS.</span></div>
</div>
</BaseLayout>