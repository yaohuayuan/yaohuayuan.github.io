---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const recentArticles = (await getCollection('articles'))
	.filter((entry) => !entry.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 5);

const formatDate = (date: Date) => date.toISOString().slice(0, 10);
---

<BaseLayout title="曜花缘" description="Systems · Database · AI · Algorithms">
	<div class="home-page">
		<section class="hero" aria-labelledby="hero-title">
			<h1 id="hero-title">曜花缘</h1>
			<p>Systems · Database · AI · Algorithms</p>
		</section>

		<section class="recent-articles" aria-labelledby="recent-title">
			<h2 id="recent-title">Recent Articles</h2>
			<ul>
				{recentArticles.map((entry) => (
					<li>
						<div class="article-title-row">
							<a href={`/articles/${entry.id}/`}>{entry.data.title}</a>
							<time datetime={formatDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
						</div>
						<p>{entry.data.description}</p>
					</li>
				))}
			</ul>
		</section>

		<section class="site-entries" aria-label="站点入口">
			<a href="/knowledge/">
				<h2>Knowledge</h2>
				<p>系统整理长期积累的技术知识。</p>
			</a>
			<a href="/projects/">
				<h2>Projects</h2>
				<p>记录工程实践与项目成果。</p>
			</a>
			<a href="/labs/">
				<h2>Labs</h2>
				<p>收纳实验、原型与探索过程。</p>
			</a>
		</section>
	</div>
</BaseLayout>

<style>
	.home-page {
		width: min(calc(100% - 2rem), var(--page-width));
		margin-inline: auto;
		padding: 3rem 0 5rem;
	}

	.hero {
		padding: clamp(2rem, 8vw, 5rem) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.hero h1 {
		margin: 0;
		font-size: clamp(2.75rem, 9vw, 5rem);
		line-height: 1.1;
	}

	.hero p {
		margin: 1rem 0 0;
		color: var(--color-muted);
		font-size: clamp(1rem, 3vw, 1.25rem);
	}

	.recent-articles {
		padding-block: 3rem;
	}

	.recent-articles h2,
	.site-entries h2 {
		margin-top: 0;
	}

	.recent-articles ul {
		margin: 1.5rem 0 0;
		padding: 0;
		border-top: 1px solid var(--color-border);
		list-style: none;
	}

	.recent-articles li {
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.article-title-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}

	.article-title-row a {
		font-size: 1.1rem;
		font-weight: 650;
	}

	.article-title-row time,
	.recent-articles li p {
		color: var(--color-muted);
	}

	.article-title-row time {
		flex: none;
		font-size: 0.9rem;
	}

	.recent-articles li p {
		margin: 0.45rem 0 0;
	}

	.site-entries {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.site-entries a {
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		text-decoration: none;
	}

	.site-entries h2 {
		margin-bottom: 0.5rem;
		font-size: 1.2rem;
	}

	.site-entries p {
		margin: 0;
		color: var(--color-muted);
	}

	@media (max-width: 640px) {
		.home-page {
			padding-top: 1.5rem;
		}

		.article-title-row {
			align-items: flex-start;
			flex-direction: column;
		}

		.site-entries {
			grid-template-columns: 1fr;
		}
	}
</style>
