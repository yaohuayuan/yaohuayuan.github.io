---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getKnowledgeSectionLabel, knowledgeSectionLabels } from '../../data/taxonomy';
import '../../styles/page.css';

const knowledgeEntries = (await getCollection('knowledge'))
	.filter((entry) => !entry.data.draft);

const groupedKnowledge = new Map<string, typeof knowledgeEntries>();

for (const entry of knowledgeEntries) {
	const entries = groupedKnowledge.get(entry.data.section) ?? [];
	entries.push(entry);
	groupedKnowledge.set(entry.data.section, entries);
}

const knowledgeSections = Array.from(groupedKnowledge, ([section, entries]) => ({
	section,
	label: getKnowledgeSectionLabel(section),
	entries: entries.sort((a, b) =>
		a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-CN')
	),
})).sort((a, b) => a.label.localeCompare(b.label, 'zh-CN'));

const knowledgeDirections = Object.values(knowledgeSectionLabels);
---

<BaseLayout title="知识库" description="长期维护的计算机与工程知识体系。">
	<div class="content-page">
		<header class="page-header">
			<h1>知识库</h1>
			<p class="page-intro">长期维护的计算机与工程知识体系。</p>
		</header>

		<div class="knowledge-groups">
			{knowledgeSections.map((group, index) => (
				<section class="knowledge-group" aria-labelledby={`knowledge-section-${index}`}>
					<h2 id={`knowledge-section-${index}`}>{group.label}</h2>
					<ul class="article-list">
						{group.entries.map((entry) => (
							<li class="article-list__item">
								<div class="article-list__heading">
									<a href={`/knowledge/${entry.id}/`}>{entry.data.title}</a>
								</div>
								<p>{entry.data.description}</p>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>

		<section class="knowledge-directions" aria-labelledby="directions-title">
			<h2 id="directions-title">知识方向</h2>
			<ul class="simple-list">
				{knowledgeDirections.map((direction) => <li>{direction}</li>)}
			</ul>
		</section>
	</div>
</BaseLayout>

<style>
	.knowledge-group + .knowledge-group,
	.knowledge-directions {
		margin-top: 3rem;
	}

	.knowledge-group h2,
	.knowledge-directions h2 {
		margin: 0 0 1rem;
		font-size: 1.4rem;
	}
</style>
