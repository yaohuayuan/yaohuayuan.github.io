---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getSeriesArticles } from '../../lib/series';

export async function getStaticPaths() {
	const entries = await getCollection('articles');
	const routableEntries = import.meta.env.DEV
		? entries
		: entries.filter((entry) => !entry.data.draft);

	return routableEntries.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// 与系列目录共用排序；草稿不进入已发布文章的连续阅读导航。
const series = entry.data.series;
const seriesArticles = series
	? getSeriesArticles(await getCollection('articles'), series)
	: [];
const position = seriesArticles.findIndex((item) => item.id === entry.id);
const previous = position > 0 ? seriesArticles[position - 1] : undefined;
const next = position >= 0 && position < seriesArticles.length - 1 ? seriesArticles[position + 1] : undefined;
---

<ArticleLayout
	title={entry.data.title}
	description={entry.data.description}
	date={entry.data.date}
	categories={entry.data.categories}
	tags={entry.data.tags}
	series={entry.data.series}
	seriesArticles={seriesArticles}
	articleId={entry.id}
	previous={previous}
	next={next}
	updated={entry.data.updated}
	headings={headings}
>
	<Content />
</ArticleLayout>
